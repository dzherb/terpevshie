{% extends '../../common/jinja/layouts/base.jinja2' %}

{% block title %}
  не мой автобус
{% endblock %}

{% block style %}
  <style>
    html, body {
      margin: 0;
      height: 100%;
      background: #14161d;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden
    }

    canvas {
      max-width: 100vw;
      max-height: 100vh;
      image-rendering: auto;
      cursor: pointer
    }
  </style>
{% endblock %}

{% block content %}
  <canvas id="c" width="960" height="540"></canvas>
{% endblock %}

{% block script %}
  <script>
    const cv = document.getElementById('c'), ctx = cv.getContext('2d');
    const W = 960, H = 540;
    const TARGET = 47;

    // ---------- Состояние ----------
    let state = 'waiting';      // waiting | boarding | ending | end
    let time = 0, missed = 0;
    let warm = 0;               // 0 — дождь и грусть, 1 — тёплый финал
    let heroX = 330, heroSit = 1; // 1 — сидит, 0 — стоит/идёт
    let thought = null, thoughtT = 0;
    let endT = 0;

    const THOUGHTS = ['Опять не мой…', 'Когда же…', 'Как же холодно…', 'Может, он не приедет?', 'Ещё чуть-чуть подожду…', '…', 'Дождь всё не кончается…'];

    // ---------- Автобус ----------
    let bus = null, nextBusIn = 3;

    function spawnBus() {
      let num;
      if (missed >= 4 && Math.random() < 0.25 + (missed - 4) * 0.15) num = TARGET;
      else {
        do {
          num = 10 + Math.floor(Math.random() * 89);
        } while (num === TARGET);
      }
      bus = {x: W + 260, num, phase: 'arrive', wait: 0, v: 0};
    }

    // ---------- Дождь ----------
    const drops = [];
    for (let i = 0; i < 160; i++) drops.push({x: Math.random() * W, y: Math.random() * H, s: 6 + Math.random() * 8});
    const glass = []; // струйки на «стекле»
    for (let i = 0; i < 7; i++) glass.push({
      x: Math.random() * W,
      y: Math.random() * H,
      v: 10 + Math.random() * 25,
      r: 1.5 + Math.random() * 2
    });

    // ---------- Звук ----------
    let audio = null;

    function initAudio() {
      if (audio) return;
      const ac = new (window.AudioContext || window.webkitAudioContext)();
      // дождь — фильтрованный шум
      const len = ac.sampleRate * 2, buf = ac.createBuffer(1, len, ac.sampleRate), d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      const noise = ac.createBufferSource();
      noise.buffer = buf;
      noise.loop = true;
      const f = ac.createBiquadFilter();
      f.type = 'lowpass';
      f.frequency.value = 900;
      const rainGain = ac.createGain();
      rainGain.gain.value = 0.10;
      noise.connect(f).connect(rainGain).connect(ac.destination);
      noise.start();
      // грустные ноты (ля-минор)
      const notes = [220, 261.63, 329.63, 246.94, 196, 261.63, 220, 174.61];
      let i = 0;

      function playNote() {
        if (!audio) return;
        const o = ac.createOscillator(), g = ac.createGain();
        o.type = 'sine';
        o.frequency.value = notes[i++ % notes.length] * (warm > 0.5 ? 1 : 0.5) * 2;
        g.gain.setValueAtTime(0.0001, ac.currentTime);
        g.gain.exponentialRampToValueAtTime(0.06, ac.currentTime + 0.1);
        g.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime + 2.2);
        o.connect(g).connect(ac.destination);
        o.start();
        o.stop(ac.currentTime + 2.3);
        setTimeout(playNote, 1400 + Math.random() * 600);
      }

      playNote();
      audio = {ac, rainGain};
    }

    cv.addEventListener('pointerdown', e => {
      initAudio();
      // клик по нужному автобусу
      if (state === 'waiting' && bus && bus.num === TARGET && bus.phase === 'stop') {
        const r = cv.getBoundingClientRect();
        const mx = (e.clientX - r.left) * W / r.width, my = (e.clientY - r.top) * H / r.height;
        if (mx > bus.x - 20 && mx < bus.x + 280 && my > 300 && my < 430) state = 'boarding';
      }
    });

    // ---------- Логика ----------
    function update(dt) {
      time += dt;
      if (thought) {
        thoughtT -= dt;
        if (thoughtT <= 0) thought = null;
      }

      if (state === 'waiting') {
        if (!bus) {
          nextBusIn -= dt;
          if (nextBusIn <= 0) spawnBus();
        } else {
          if (bus.phase === 'arrive') {
            const target = 470;
            bus.x += -Math.max(60, (bus.x - target) * 1.8) * dt;
            if (bus.x <= target) {
              bus.x = target;
              bus.phase = 'stop';
              bus.wait = bus.num === TARGET ? 6 : 1.8;
            }
          } else if (bus.phase === 'stop') {
            bus.wait -= dt;
            if (bus.wait <= 0) {
              if (bus.num === TARGET) {
                state = 'boarding';
              } else bus.phase = 'leave';
            }
          } else if (bus.phase === 'leave') {
            bus.v += 250 * dt;
            bus.x -= bus.v * dt;
            if (bus.x < -320) {
              bus = null;
              missed++;
              nextBusIn = 3.5 + Math.random() * 3;
              thought = THOUGHTS[Math.floor(Math.random() * THOUGHTS.length)];
              thoughtT = 2.5;
            }
          }
        }
      } else if (state === 'boarding') {
        heroSit = Math.max(0, heroSit - dt * 2);
        if (heroSit === 0) {
          heroX += 90 * dt;
          if (heroX > bus.x + 170) {
            state = 'ending';
          }
        }
      } else if (state === 'ending') {
        warm = Math.min(1, warm + dt * 0.25);
        if (audio) audio.rainGain.gain.value = 0.10 * (1 - warm);
        bus.v = (bus.v || 0) + 150 * dt * warm;
        bus.x -= bus.v * dt * warm;
        endT += dt;
        if (warm >= 1 && endT > 5) state = 'end';
      }

      // дождь
      const rain = 1 - warm;
      for (const p of drops) {
        p.y += (380 + p.s * 20) * dt * rain;
        p.x -= 60 * dt * rain;
        if (p.y > H) {
          p.y = -10;
          p.x = Math.random() * W;
        }
      }
      for (const g of glass) {
        g.y += g.v * dt * rain;
        if (g.y > H) {
          g.y = -10;
          g.x = Math.random() * W;
        }
      }
    }

    // ---------- Утилиты рисования ----------
    function lerp(a, b, t) {
      return a + (b - a) * t
    }

    function col(c1, c2, t) { // c = [r,g,b]
      return `rgb(${lerp(c1[0], c2[0], t) | 0},${lerp(c1[1], c2[1], t) | 0},${lerp(c1[2], c2[2], t) | 0})`;
    }

    function rr(x, y, w, h, r) {
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, r);
      ctx.fill();
    }

    // ---------- Рендер ----------
    function draw() {
      // небо
      const sky = ctx.createLinearGradient(0, 0, 0, H);
      sky.addColorStop(0, col([34, 40, 56], [120, 90, 110], warm));
      sky.addColorStop(1, col([48, 56, 74], [235, 160, 110], warm));
      ctx.fillStyle = sky;
      ctx.fillRect(0, 0, W, H);

      // дальние дома
      ctx.fillStyle = col([40, 46, 62], [90, 70, 95], warm);
      for (let i = 0; i < 6; i++) {
        const bx = i * 180 - 40, bh = 120 + ((i * 53) % 90);
        ctx.fillRect(bx, 330 - bh, 140, bh);
        ctx.fillStyle = col([70, 80, 100], [255, 210, 140], warm * 0.8);
        for (let wy = 0; wy < bh - 30; wy += 34) for (let wx = 14; wx < 120; wx += 34)
          if ((i * 7 + wx + wy) % 5 > 1) ctx.fillRect(bx + wx, 330 - bh + 14 + wy, 14, 18);
        ctx.fillStyle = col([40, 46, 62], [90, 70, 95], warm);
      }

      // дорога и тротуар
      ctx.fillStyle = col([30, 33, 44], [70, 60, 70], warm);
      ctx.fillRect(0, 330, W, 130);
      ctx.fillStyle = col([45, 50, 66], [110, 90, 100], warm);
      ctx.fillRect(0, 460, W, 80);
      // лужи
      ctx.fillStyle = `rgba(140,170,210,${0.18 * (1 - warm) + 0.05})`;
      ctx.beginPath();
      ctx.ellipse(180, 475, 70, 9, 0, 0, 7);
      ctx.ellipse(700, 500, 100, 11, 0, 0, 7);
      ctx.ellipse(440, 520, 60, 8, 0, 0, 7);
      ctx.fill();

      // фонарь
      ctx.fillStyle = '#1a1d26';
      ctx.fillRect(140, 170, 8, 300);
      ctx.fillRect(120, 165, 60, 10);
      const lamp = ctx.createRadialGradient(150, 180, 5, 150, 180, 200);
      lamp.addColorStop(0, `rgba(255,230,170,${0.35 + 0.1 * warm})`);
      lamp.addColorStop(1, 'rgba(255,230,170,0)');
      ctx.fillStyle = lamp;
      ctx.beginPath();
      ctx.moveTo(150, 180);
      ctx.lineTo(60, 470);
      ctx.lineTo(260, 470);
      ctx.fill();
      ctx.fillStyle = '#ffe6aa';
      ctx.beginPath();
      ctx.arc(150, 180, 8, 0, 7);
      ctx.fill();

      // автобус (за остановкой)
      if (bus) drawBus(bus);

      // остановка
      drawStop();

      // герой
      drawHero();

      // мысль
      if (thought) drawThought();

      // дождь
      ctx.strokeStyle = `rgba(170,195,230,${0.35 * (1 - warm)})`;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      for (const p of drops) {
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(p.x - 2, p.y + p.s);
      }
      ctx.stroke();
      // струйки на «стекле»
      ctx.fillStyle = `rgba(200,220,250,${0.25 * (1 - warm)})`;
      for (const g of glass) {
        ctx.beginPath();
        ctx.arc(g.x, g.y, g.r, 0, 7);
        ctx.fill();
        ctx.fillRect(g.x - 0.6, g.y - 30, 1.2, 30);
      }

      // интерфейс
      ctx.fillStyle = `rgba(255, 255, 255, 0.85)`;
      ctx.font = '16px Georgia';
      ctx.textAlign = 'left';
      ctx.fillText('Не мой автобус', 20, 30);
      ctx.font = '13px Georgia';
      ctx.fillStyle = 'rgba(255,255,255,0.5)';
      if (state === 'waiting') ctx.fillText(`Жду автобус №${TARGET}.  Мимо проехало: ${missed}`, 20, 52);

      // финал
      if (state === 'ending' || state === 'end') {
        ctx.textAlign = 'center';
        ctx.fillStyle = `rgba(255,255,255,${Math.min(1, endT / 2)})`;
        ctx.font = '26px Georgia';
        ctx.fillText('Наконец-то… Мой автобус.', W / 2, 120);
        if (state === 'end' || endT > 3.5) {
          ctx.font = '18px Georgia';
          ctx.fillStyle = `rgba(255,255,255,${Math.min(1, (endT - 3.5) / 1.5)})`;
          ctx.fillText(`Конец. Пропущено автобусов: ${missed}`, W / 2, 160);
        }
      }
    }

    function drawBus(b) {
      const x = b.x;
      ctx.save();
      // корпус
      ctx.fillStyle = b.num === TARGET ? col([90, 130, 160], [255, 180, 90], warm) : '#4a5570';
      rr(x, 300, 280, 110, 10);
      // окна
      ctx.fillStyle = col([180, 200, 225], [255, 235, 190], warm);
      for (let i = 0; i < 4; i++) rr(x + 18 + i * 62, 315, 48, 40, 4);
      // дверь
      ctx.fillStyle = '#2c3344';
      rr(x + 228, 320, 40, 86, 4);
      // колёса
      ctx.fillStyle = '#181b24';
      ctx.beginPath();
      ctx.arc(x + 60, 415, 20, 0, 7);
      ctx.arc(x + 220, 415, 20, 0, 7);
      ctx.fill();
      ctx.fillStyle = '#3a4154';
      ctx.beginPath();
      ctx.arc(x + 60, 415, 9, 0, 7);
      ctx.arc(x + 220, 415, 9, 0, 7);
      ctx.fill();
      // табло с номером
      ctx.fillStyle = '#11131a';
      rr(x + 90, 285, 100, 26, 5);
      ctx.fillStyle = b.num === TARGET ? '#ffd966' : '#9fb4d8';
      ctx.font = 'bold 20px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('№ ' + b.num, x + 140, 305);
      // фары
      ctx.fillStyle = '#ffe6aa';
      ctx.fillRect(x + 2, 380, 8, 10);
      if (b.num === TARGET && b.phase === 'stop' && state === 'waiting') {
        ctx.fillStyle = `rgba(255,220,120,${0.6 + 0.4 * Math.sin(time * 6)})`;
        ctx.font = '15px Georgia';
        ctx.fillText('Это он! Нажми!', x + 140, 270);
      }
      ctx.restore();
    }

    function drawStop() {
      // навес
      ctx.fillStyle = '#222633';
      ctx.fillRect(270, 200, 10, 250);
      ctx.fillRect(420, 200, 10, 250);
      ctx.fillStyle = col([60, 70, 95], [140, 110, 110], warm);
      rr(255, 185, 190, 20, 6);
      // табло остановки
      ctx.fillStyle = '#181b24';
      rr(285, 215, 130, 30, 5);
      ctx.fillStyle = '#8fb6e8';
      ctx.font = '13px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(`жду: №${TARGET}`, 350, 235);
      // скамейка
      ctx.fillStyle = '#39405a';
      rr(290, 395, 120, 12, 4);
      ctx.fillRect(298, 407, 8, 40);
      ctx.fillRect(394, 407, 8, 40);
    }

    function drawHero() {
      const sit = heroSit;
      const hy = lerp(355, 340, 1 - sit); // выше, когда встал
      ctx.save();
      ctx.translate(heroX, hy);
      // ноги
      ctx.strokeStyle = '#2b3046';
      ctx.lineWidth = 8;
      ctx.lineCap = 'round';
      ctx.beginPath();
      if (sit > 0.5) {
        ctx.moveTo(0, 30);
        ctx.lineTo(18, 42);
        ctx.lineTo(18, 62);
      } else {
        const step = Math.sin(time * 10) * (state === 'boarding' ? 8 : 0);
        ctx.moveTo(0, 30);
        ctx.lineTo(step, 72);
        ctx.moveTo(0, 30);
        ctx.lineTo(-step, 72);
      }
      ctx.stroke();
      // тело
      ctx.strokeStyle = col([70, 80, 110], [200, 140, 90], warm);
      ctx.lineWidth = 12;
      ctx.beginPath();
      ctx.moveTo(0, 30);
      ctx.lineTo(sit > 0.5 ? -4 : 0, 0);
      ctx.stroke();
      // голова
      ctx.fillStyle = '#d8c5b0';
      ctx.beginPath();
      ctx.arc(sit > 0.5 ? -6 : 0, -12, 11, 0, 7);
      ctx.fill();
      // лицо: грустное или радостное
      ctx.strokeStyle = '#5a4a3a';
      ctx.lineWidth = 1.5;
      const hx = sit > 0.5 ? -6 : 0;
      ctx.beginPath();
      if (warm > 0.3 || state === 'boarding') {
        ctx.arc(hx, -9, 4, 0.2, Math.PI - 0.2);
      }       // улыбка
      else {
        ctx.arc(hx, -5, 4, Math.PI + 0.3, -0.3);
      }                                     // грусть
      ctx.stroke();
      ctx.fillStyle = '#3a3a3a';
      ctx.fillRect(hx - 4, -15, 2, 2);
      ctx.fillRect(hx + 2, -15, 2, 2);
      ctx.restore();
    }

    function drawThought() {
      const a = Math.min(1, thoughtT);
      ctx.save();
      ctx.globalAlpha = a;
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.font = 'italic 14px Georgia';
      const w = ctx.measureText(thought).width + 24;
      rr(heroX - w / 2, 245, w, 28, 14);
      ctx.beginPath();
      ctx.arc(heroX - 8, 282, 4, 0, 7);
      ctx.arc(heroX - 2, 290, 2.5, 0, 7);
      ctx.fill();
      ctx.fillStyle = '#333a4d';
      ctx.textAlign = 'center';
      ctx.fillText(thought, heroX, 264);
      ctx.restore();
    }

    // ---------- Цикл ----------
    let last = performance.now();

    function loop(now) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      update(dt);
      draw();
      requestAnimationFrame(loop);
    }

    requestAnimationFrame(loop);
  </script>
{% endblock %}