{% macro html() %}
  <canvas id="fog" aria-hidden="true"></canvas>
{% endmacro %}

<style>
  {% macro styles() %}
    #fog {
      position: fixed;
      inset: 0;
      z-index: -1;
      width: 100%;
      height: 100%;
      display: block;
      background: #414141;
    }
  {% endmacro %}
</style>

{% macro script() %}
  <script>
    (() => {
      const canvas = document.getElementById('fog');
      const gl = canvas && canvas.getContext('webgl', { antialias: false, depth: false });
      if (!gl) return;

      const RESOLUTION_SCALE = 0.5;

      const vertexShader = `
        attribute vec2 position;
        void main() { gl_Position = vec4(position, 0.0, 1.0); }
      `;

      const fragmentShader = `
        precision highp float;

        uniform vec2 iResolution;
        uniform float iTime;

        const float blurFactor = 0.48;
        const float zoom = 1.8;

        const float detail = 2.0;
        const vec3 baseColor = vec3(0.255);       // #414141
        const vec3 lowlightColor = vec3(0.616);   // #9d9d9d
        const vec3 midtoneColor = vec3(0.694);    // #b1b1b1
        const vec3 highlightColor = vec3(0.0);

        float random(vec2 st) {
          return fract(sin(dot(st, vec2(0.129898, 0.78233))) * 437.585453123);
        }

        float noise(vec2 st) {
          vec2 i = floor(st);
          vec2 f = fract(st);
          float a = random(i);
          float b = random(i + vec2(1.0, 0.0));
          float c = random(i + vec2(0.0, 1.0));
          float d = random(i + vec2(1.0, 1.0));
          vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
        }

        float fbm(vec2 st) {
          float value = 0.0;
          float amplitude = blurFactor;
          mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));
          for (int i = 0; i < 6; ++i) {
            value += amplitude * noise(st);
            st = rot * st * 2.0 + vec2(100.0);
            amplitude *= 1.0 - blurFactor;
          }
          return value;
        }

        void main() {
          vec2 st = gl_FragCoord.xy / iResolution.xy * 3.0 * detail;
          st.x *= 0.7 * iResolution.x / iResolution.y;
          st *= zoom;

          vec2 q = vec2(fbm(st), fbm(st + vec2(1.0)));

          vec2 drift = vec2(0.15, 0.126);
          vec2 r = vec2(
            fbm(st + q + vec2(1.7, 9.2) + drift.x * iTime),
            fbm(st + q + vec2(8.3, 2.8) + drift.y * iTime)
          );

          float f = fbm(st + r);

          vec3 color = mix(baseColor, lowlightColor, clamp(f * f * 4.0, 0.0, 1.0));
          color = mix(color, midtoneColor, clamp(length(q), 0.0, 1.0));
          color = mix(color, highlightColor, clamp(length(r.x), 0.0, 1.0));

          gl_FragColor = vec4(
            mix(baseColor, color, f * f * f + 0.6 * f * f + 0.5 * f),
            1.0
          );
        }
      `;

      const compile = (type, source) => {
        const shader = gl.createShader(type);
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        return gl.getShaderParameter(shader, gl.COMPILE_STATUS) ? shader : null;
      };

      const vs = compile(gl.VERTEX_SHADER, vertexShader);
      const fs = compile(gl.FRAGMENT_SHADER, fragmentShader);
      if (!vs || !fs) return;

      const program = gl.createProgram();
      gl.attachShader(program, vs);
      gl.attachShader(program, fs);
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
      gl.useProgram(program);

      // Один треугольник с запасом перекрывает экран — дешевле двух
      const buffer = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const position = gl.getAttribLocation(program, 'position');
      gl.enableVertexAttribArray(position);
      gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

      const iResolution = gl.getUniformLocation(program, 'iResolution');
      const iTime = gl.getUniformLocation(program, 'iTime');

      const resize = () => {
        canvas.width = Math.max(1, Math.floor(canvas.clientWidth * RESOLUTION_SCALE));
        canvas.height = Math.max(1, Math.floor(canvas.clientHeight * RESOLUTION_SCALE));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(iResolution, canvas.width, canvas.height);
      };

      const draw = (seconds) => {
        gl.uniform1f(iTime, seconds);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };

      const still = matchMedia('(prefers-reduced-motion: reduce)');
      let frame = null;
      let start = null;

      resize();
      // Первый кадр рисуем сразу и безусловно: страница могла открыться в
      // фоновой вкладке, где requestAnimationFrame не тикает, — фон не должен
      // остаться пустым до переключения на неё.
      draw(0);

      addEventListener('resize', () => {
        resize();
        if (frame === null) draw(0);
      });

      const loop = (now) => {
        if (start === null) start = now;
        draw((now - start) / 1000);
        frame = requestAnimationFrame(loop);
      };

      const play = () => {
        if (frame === null && !still.matches && !document.hidden) {
          frame = requestAnimationFrame(loop);
        }
      };

      const pause = () => {
        if (frame !== null) cancelAnimationFrame(frame);
        frame = null;
      };

      // Не жжём батарею в фоновой вкладке и при отключённой анимации
      document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
      still.addEventListener('change', () => (still.matches ? pause() : play()));

      play();
    })();
  </script>
{% endmacro %}
