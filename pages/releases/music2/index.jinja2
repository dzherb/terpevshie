{% extends '../../common/jinja/layouts/base.jinja2' %}

{% block title %}
  потерпевшие - музыка 2
{% endblock %}

{% block head %}
  <meta name="description"
        content="Тизер альбома &quot;музыка 2&quot; группы &quot;потерпевшие&quot;. Релиз - в августе 2026.">
  <meta property="og:title" content="потерпевшие - музыка 2">
  <meta property="og:description" content="релиз в августе 2026">
  <link rel="canonical" href="{{ site_url }}{{ page_path }}">
  <meta property="og:image" content="{{ site_url }}{{ page_path }}/bg.webp">
  <meta property="og:url" content="{{ site_url }}{{ page_path }}">
  <meta property="og:type" content="website">
  {% include '../../common/jinja/includes/font_old_standard.html' %}
  {% include '../../common/jinja/includes/favicon_tags.html' %}
{% endblock %}

{# Components #}
{% import '../../common/jinja/components/navbar.jinja2' as navbar %}

{% block content %}
  <div id="bg"></div>

  {{ navbar.html() }}

  <main class="font-regular">
    <div id="teaser-card">
      <h1 class="font-bold">МУЗЫКА 2</h1>
      <p id="release-date" >август 2026</p>

      <div id="play-wrap">
        <svg id="progress-ring" viewBox="0 0 72 72" aria-hidden="true">
          <circle class="ring-track" cx="36" cy="36" r="32"></circle>
          <circle class="ring-fill" cx="36" cy="36" r="32"></circle>
        </svg>
        <button id="play-btn" aria-label="прослушать тизер">
          <svg class="icon icon-play" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <polygon points="5,3 19,12 5,21" fill="currentColor"></polygon>
          </svg>
          <svg class="icon icon-pause" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <rect x="6" y="4" width="4" height="16" fill="currentColor"></rect>
            <rect x="14" y="4" width="4" height="16" fill="currentColor"></rect>
          </svg>
        </button>
      </div>

      <audio id="teaser-audio" src="./края_teaser.mp3"></audio>
    </div>
  </main>

  <canvas id="noise-overlay" aria-hidden="true"></canvas>
{% endblock %}

{% block script %}
  <script>
    const audio = document.getElementById('teaser-audio');
    const playBtn = document.getElementById('play-btn');
    const ringFill = document.querySelector('.ring-fill');
    const RING_CIRCUMFERENCE = 2 * Math.PI * 32;
    ringFill.style.strokeDasharray = `${RING_CIRCUMFERENCE}`;
    ringFill.style.strokeDashoffset = `${RING_CIRCUMFERENCE}`;

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().catch(err => console.log('Autoplay failed:', err));
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', () => {
      playBtn.classList.add('playing');
    });

    audio.addEventListener('pause', () => {
      playBtn.classList.remove('playing');
    });

    audio.addEventListener('ended', () => {
      playBtn.classList.remove('playing');
      audio.currentTime = 0;
      ringFill.style.strokeDashoffset = `${RING_CIRCUMFERENCE}`;
    });

    audio.addEventListener('timeupdate', () => {
      const percent = (audio.currentTime / audio.duration) || 0;
      ringFill.style.strokeDashoffset = `${RING_CIRCUMFERENCE * (1 - percent)}`;
    });

    /* NOISE / плохой сигнал */

    const noiseCanvas = document.getElementById('noise-overlay');
    const nctx = noiseCanvas.getContext('2d');
    const NOISE_W = 160, NOISE_H = 90;
    noiseCanvas.width = NOISE_W;
    noiseCanvas.height = NOISE_H;

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

    function drawNoise(alpha) {
      const imageData = nctx.createImageData(NOISE_W, NOISE_H);
      const data = imageData.data;
      for (let i = 0; i < data.length; i += 4) {
        const v = Math.random() * 255;
        data[i] = data[i + 1] = data[i + 2] = v;
        data[i + 3] = alpha;
      }
      nctx.putImageData(imageData, 0, 0);
    }

    drawNoise(14);

    if (!reducedMotion.matches) {
      let glitchUntil = 0;
      let frame = null;

      const tick = (now) => {
        const glitching = now < glitchUntil;
        drawNoise(glitching ? 70 : 14);
        noiseCanvas.style.opacity = glitching ? (Math.random()*0.3) : 0.15;
        noiseCanvas.style.transform = glitching
          ? `translate(${(Math.random() - 0.5) * 8}px, ${(Math.random() - 0.5) * 8}px)`
          : 'translate(0, 0)';

        if (now > glitchUntil && Math.random() < 0.01) {
          glitchUntil = now + 80 + Math.random() * 220;
        }

        frame = requestAnimationFrame(tick);
      };

      const play = () => {
        if (frame === null && !document.hidden) frame = requestAnimationFrame(tick);
      };

      const pause = () => {
        if (frame !== null) cancelAnimationFrame(frame);
        frame = null;
      };

      document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
      play();
    }
  </script>
{% endblock %}

{% block style %}
  <style>
    {% include '../../common/jinja/includes/simple_reset.css' %}
    {% include '../../common/jinja/includes/view_transition.css' %}

    .font-regular {
      font-family: "Old Standard TT", serif;
      font-weight: 400;
      font-style: normal;
    }

    .font-bold {
      font-family: "Old Standard TT", serif;
      font-weight: 700;
      font-style: normal;
    }

    body {
      position: relative;
      background-color: #ddeffa;
      color: #e2e6ec;
      min-height: 100vh;
    }

    #bg {
      position: fixed;
      inset: 0;
      z-index: -1;
      background-image: url("./bg.webp");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      background: rgba(21, 26, 36, 0.25);
      pointer-events: none;
    }

    {{ navbar.styles() }}

    #logo-img {
      filter: invert(1);
    }

    main {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #teaser-card {
      position: relative;
      z-index: 1;
      margin: 4.6rem 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.2rem;
      text-align: center;
    }

    #teaser-card h1 {
      font-weight: normal;
      letter-spacing: 0.08em;
      margin: 0;
      font-size: 4rem;
    }

    #release-date {
      margin: 0;
      font-size: 1.4rem;
      opacity: 0.85;
    }

    #play-wrap {
      position: relative;
      margin-top: 1rem;
      width: 72px;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #progress-ring {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
      pointer-events: none;
    }

    #progress-ring circle {
      fill: none;
      stroke-width: 2;
    }

    .ring-track {
      stroke: rgba(187, 193, 202, 0.2);
    }

    .ring-fill {
      stroke: #d3dff6;
      stroke-linecap: round;
      stroke-dasharray: 201.06;
      stroke-dashoffset: 201.06;
      transition: stroke-dashoffset 0.15s linear;
    }

    #play-btn {
      position: relative;
      width: 4rem;
      height: 4rem;
      border-radius: 50%;
      border: 1px solid rgba(187, 193, 202, 0.5);
      background: rgba(187, 193, 202, 0.08);
      color: inherit;
      cursor: pointer;
      transition: transform 0.3s ease, background 0.3s ease;
    }

    #play-btn:hover {
      transform: scale(1.05);
      background: rgba(187, 193, 202, 0.16);
    }

    #play-btn .icon {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: block;
      pointer-events: none;
    }

    #play-btn .icon-play {
      transform: translate(-45%, -50%);
    }

    #play-btn .icon-pause,
    #play-btn.playing .icon-play {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.8);
      transition: opacity 0.18s ease, transform 0.18s ease;
    }

    #play-btn.playing .icon-pause {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    #noise-overlay {
      position: fixed;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      opacity: 0.07;
      mix-blend-mode: overlay;
      pointer-events: none;
      image-rendering: pixelated;
    }

    @media (max-width: {{ sm_breakpoint }}px) {
      #teaser-card h1 {
        font-size: 2.8rem;
      }
    }
  </style>
{% endblock %}
